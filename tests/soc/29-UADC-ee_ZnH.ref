#INFO: **** input file is /home/chiang.272/prism/tests/soc/29-UADC-ee_ZnH.py ****
import numpy as np
import math
import unittest
import pyscf.gto
import pyscf.scf
import pyscf.mcscf
import prism.interface
import prism.nevpt
from pyscf import mcpdft
from prism.libsoc import general_somf
from pyscf import adc
from pyscf import scf
from pyscf.adc import uadc_ea
import prism.interface_soc
from prism.libsoc import general_somf
from prism.tools import trans_prop
import os
import sys
import basis_set_exchange as bse

np.set_printoptions(suppress=True)

mol = pyscf.gto.Mole()
mol.atom = [ 
            ['Zn', (0.0, 0.0, 0.0)],
            ['H', (0.0,  0,  1.595 )]
]
mol.basis = 'def2-tzvp' #'6-31g'
#mol.basis = bse.get_basis('ano-rcc-vtzp',fmt='nwchem',header=False) #x2c-tzvpall-2c
mol.symmetry = False
mol.spin = 1
mol.charge = 0
mol.verbose = 4
mol.build()


mf = scf.UHF(mol).x2c()
mf.conv_tol = 1e-12
#mf.max_cycle = 1
mf.kernel()
mf.analyze()

myadc = adc.ADC(mf)
myadc.method_type = "ee"
myadc.compute_spin_square = True
E,U,P,X = myadc.kernel(nroots=10)



interface = prism.interface_soc.PYSCF_ADC(mf,myadc,E,U,P,X)
interface.soc = "bp"
interface.gtensor=True
en_soc, properties = interface.kernel()
exit()

class KnownValues(unittest.TestCase):

    def test_pyscf(self):
        self.assertAlmostEqual(E[0],  0.1083915612, 6)
        self.assertAlmostEqual(E[1],  0.1083915612, 6)
        self.assertAlmostEqual(E[2],  0.1742387868, 6)
        self.assertAlmostEqual(E[3],  0.2260147508, 6)
        self.assertAlmostEqual(E[4],  0.2260147508, 6)
        self.assertAlmostEqual(E[5],  0.2338904156, 6)
        self.assertAlmostEqual(E[6],  0.2502417501, 6)
        self.assertAlmostEqual(E[7],  0.2502417501, 6)
        self.assertAlmostEqual(E[8],  0.2672107547, 6)
        self.assertAlmostEqual(E[9],  0.2728717307, 6)


        

    def test_prism(self):

        en_soc, properties = interface.kernel()

        self.assertAlmostEqual(en_soc[0],    -1792.198980901910, 5)
        self.assertAlmostEqual(en_soc[1],    -1792.198980901909, 5)
        self.assertAlmostEqual(en_soc[2],    -1792.091243223571, 5)
        self.assertAlmostEqual(en_soc[3],    -1792.091243223571, 5)
        self.assertAlmostEqual(en_soc[4],    -1792.089912686355, 5)
        self.assertAlmostEqual(en_soc[5],    -1792.089912686355, 5)
        self.assertAlmostEqual(en_soc[6],    -1792.024806581909, 5)
        self.assertAlmostEqual(en_soc[7],    -1792.024806581906, 5)
        self.assertAlmostEqual(en_soc[8],    -1791.973157990515, 5)
        self.assertAlmostEqual(en_soc[9],    -1791.973157990515, 5)
        self.assertAlmostEqual(en_soc[10],   -1791.973027996658, 5)
        self.assertAlmostEqual(en_soc[11],   -1791.973027996657, 5)
        self.assertAlmostEqual(en_soc[12],   -1791.972892644187, 5)
        self.assertAlmostEqual(en_soc[13],   -1791.972892644187, 5)
        self.assertAlmostEqual(en_soc[14],   -1791.972752669756, 5)
        self.assertAlmostEqual(en_soc[15],   -1791.972752669756, 5)
        self.assertAlmostEqual(en_soc[16],   -1791.965337741624, 5)
        self.assertAlmostEqual(en_soc[17],   -1791.965337741622, 5)
        self.assertAlmostEqual(en_soc[18],   -1791.950948319357, 5)
        self.assertAlmostEqual(en_soc[19],   -1791.950948319357, 5)
        self.assertAlmostEqual(en_soc[20],   -1791.946601981287, 5)
        self.assertAlmostEqual(en_soc[21],   -1791.946601981286, 5)
        self.assertAlmostEqual(en_soc[22],   -1791.931375089500, 5)
        self.assertAlmostEqual(en_soc[23],   -1791.931375089499, 5)
        self.assertAlmostEqual(en_soc[24],   -1791.926058599210, 5)
        self.assertAlmostEqual(en_soc[25],   -1791.926058599209, 5)


        g_factor = properties["g-factors"]
        self.assertAlmostEqual(g_factor[0], 1.985173, 5)
        self.assertAlmostEqual(g_factor[1], 1.986004, 5)
        self.assertAlmostEqual(g_factor[2], 2.002212, 5)


        


if __name__ == "__main__":
    print("ADC-ea test")
    unittest.main()#INFO: ******************** input file end ********************


