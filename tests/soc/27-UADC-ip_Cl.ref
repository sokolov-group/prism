#INFO: **** input file is /home/chiang.272/prism/tests/soc/27-UADC-ip_Cl.py ****
import unittest
import numpy as np
import math
import pyscf.gto
import pyscf.scf
import pyscf.mcscf
from pyscf import mcpdft
from pyscf import adc
from pyscf import scf
from pyscf.adc import uadc_ea
import prism.interface_soc


np.set_printoptions(suppress=True)

mol = pyscf.gto.Mole()
mol.atom = [
            ['Cl', (0.0, 0.0, 0.0)]]
mol.basis = 'def2-tzvp'
mol.symmetry = False
mol.spin = 0
mol.verbose = 4
mol.charge = -1
mol.build()


mf = scf.UHF(mol).x2c()
mf.conv_tol = 1e-12
mf.kernel()

myadc = adc.ADC(mf)
#myadc.conv_tol = 1e-12
#myadc.tol_residual = 1e-6
myadc.method_type = "ip"

E,U,P,X = myadc.kernel(nroots=12)

interface = prism.interface_soc.PYSCF_ADC(mf,myadc,E,U,P,X)
en_soc, properties = interface.kernel()

exit()

class KnownValues(unittest.TestCase):

    def test_pyscf(self):
        self.assertAlmostEqual(E[0],  0.1057013423  , 6)
        self.assertAlmostEqual(E[1],  0.1057013423  , 6)
        self.assertAlmostEqual(E[2],  0.1057013423  , 6)
        self.assertAlmostEqual(E[3],  0.1057013423  , 6)
        self.assertAlmostEqual(E[4],  0.1057013423  , 6)
        self.assertAlmostEqual(E[5],  0.1057013423  , 6)
        self.assertAlmostEqual(E[6],  0.5696265266  , 6)
        self.assertAlmostEqual(E[7],  0.5696265266  , 6)
        self.assertAlmostEqual(E[8],  1.0361739834  , 6)
        self.assertAlmostEqual(E[9],  1.0361739834  , 6)
        self.assertAlmostEqual(E[10],  1.0361789863 , 6)
        self.assertAlmostEqual(E[11],  1.0361789863 , 6)


        

    def test_prism(self):

        en_soc, properties = interface.kernel()

        self.assertAlmostEqual(en_soc[0],  0.104603613681  , 5)
        self.assertAlmostEqual(en_soc[1],  0.104603613681  , 5)
        self.assertAlmostEqual(en_soc[2],  0.104605476098  , 5)
        self.assertAlmostEqual(en_soc[3],  0.104605476098  , 5)
        self.assertAlmostEqual(en_soc[4],  0.107894894786  , 5)
        self.assertAlmostEqual(en_soc[5],  0.107894894786  , 5)
        self.assertAlmostEqual(en_soc[6],  0.569626526561  , 5)
        self.assertAlmostEqual(en_soc[7],  0.569626526561  , 5)
        self.assertAlmostEqual(en_soc[8],  1.035969066173  , 5)
        self.assertAlmostEqual(en_soc[9],  1.035969066173  , 5)
        self.assertAlmostEqual(en_soc[10], 1.036107306745  , 5)
        self.assertAlmostEqual(en_soc[11], 1.036107306745  , 5)
        self.assertAlmostEqual(en_soc[12], 1.036245676164  , 5)
        self.assertAlmostEqual(en_soc[13], 1.036245676164  , 5)
        self.assertAlmostEqual(en_soc[14], 1.036383932702  , 5)
        self.assertAlmostEqual(en_soc[15], 1.036383932702  , 5)




        


if __name__ == "__main__":
    print("ADC-ea test")
    unittest.main()
